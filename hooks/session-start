#!/usr/bin/env bash
# Lope SessionStart hook — injects a brief "lope is available" context
# into the agent's session. Works for Claude Code, Cursor, and any host
# that reads hookSpecificOutput.additionalContext or additional_context.
#
# Respects LOPE_HOOK=off to disable the briefing entirely.
# Bash 3.2 compatible (stock macOS).

set -euo pipefail

# Opt-out
if [ "${LOPE_HOOK:-}" = "off" ]; then
  printf '{}\n'
  exit 0
fi

# The brief we inject. Deliberately short (~250 tokens). Specific about
# when to use lope and when NOT to, so it doesn't spam agents on trivial
# tasks.
read -r -d '' _LOPE_BRIEF <<'EOF' || true
<lope-available>
Lope is installed. Lope is a multi-CLI validator ensemble for AI work. Any AI CLI implements, any AI CLI validates.

16 core commands available:
- Sprint modes: /lope-negotiate, /lope-execute, /lope-implement, /lope-audit
- Single-shot: /lope-ask, /lope-review, /lope-vote, /lope-compare, /lope-pipe
- Other commands: /lope-team (roster), /lope-flow (graph), /lope-memory (history), /lope-deliberate (council), /lope-headroom (MCP compression), /lope-help (docs), /lope (umbrella)

TWO WAYS THE USER WILL INVOKE LOPE:
1. Explicit slash command. They type /lope-negotiate "goal" (Gemini uses /lope:negotiate). Route to that skill.
2. Natural language. They describe multi-phase work in prose ("plan the auth refactor", "scope the data migration"). You recognize the shape and invoke lope yourself. Extract the goal from their prose as the sprint goal string. Pick --domain engineering (code) / business / research. Run `lope negotiate "goal" --domain X`.

TRIGGER WORDS for natural-language path: plan, negotiate, scope, draft, roll out, work through, "carefully", "needs to be right", "what do other models think", A/B compare.
DO NOT TRIGGER on: single-edit tasks (rename, typo, one-line fix), pure conversation, trivial operations, urgent fire-fighting.

DO NOT WRITE WRAPPER SCRIPTS AROUND LOPE. Invoke `lope <verb> <args>` directly in a shell.
DO NOT INVENT FLAGS. Run `lope <verb> --help` if unsure. Current flags:
- Pool/sprint/single-shot flags: --validators, --primary, --timeout, --parallel, --sequential, --domain, --out, --max-rounds, --context, --context-file, --phase, --manual, --gates, --gate-config, --trust, --json, --synth, --anonymous, --consensus, --structured, --min-consensus, --similarity, --format, --include-raw, --remember, --divide, --roles, --options, --criteria, --require-all, --brain-context, --brain-budget, --brain-log.

Default voice for internal work: intelligent caveman mode (terse, token-efficient). Auto-disabled for external writing.
Install path is git checkout in ~/.lope; server updates use `lope update` (PyPI is not live yet). Headroom compression is optional/opt-in via /lope-headroom.

Samples: $HOME/.lope/docs/samples.md
Umbrella skill: $HOME/.lope/skills/lope/SKILL.md
Auto-trigger skill: $HOME/.lope/skills/using-lope/SKILL.md
</lope-available>
EOF

# Escape for JSON embedding using parameter substitution (fast, no jq dep).
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

_LOPE_BRIEF_ESCAPED="$(escape_for_json "$_LOPE_BRIEF")"

# Emit the right JSON shape for the host that invoked this hook.
#   - Cursor sets CURSOR_PLUGIN_ROOT → wants additional_context (snake_case)
#   - Claude Code sets CLAUDE_PLUGIN_ROOT → wants hookSpecificOutput.additionalContext
#   - Others default to additional_context (SDK standard)
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$_LOPE_BRIEF_ESCAPED"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"additionalContext":"%s"}}\n' "$_LOPE_BRIEF_ESCAPED"
else
  printf '{"additional_context":"%s"}\n' "$_LOPE_BRIEF_ESCAPED"
fi
